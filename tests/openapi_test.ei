// openapi: schemas (rendering, validation of JSON values and parameter text), operations
// (path templates, checks of their declarations), the document, a service's validation
// (400 problem+json listing every error, 415, 413, 401 for secured operations), typed
// handlers, and the pretty printer. Handlers are called directly (no sockets).

import "core/sys"
import "std/bytes"
import "std/io"
import "json"
import "http"
import "http/problem"
import "../openapi.ei"
import "../schema.ei"

fn lit(s: str) -> List[u8] { sys.lit(s) }

fn show(r: http.Response) uses io {
    let mut l = bytes.from_u64(r.status as u64)
    l.push(32)
    for h in r.headers {
        bytes.append(inout l, h.name)
        l.push(61)
        bytes.append(inout l, h.value)
        l.push(32)
    }
    bytes.append(inout l, lit("| "))
    bytes.append(inout l, r.body)
    io.outln(l)
}

fn errs(s: schema.Schema, text: str) uses io {
    let mut l = lit(text)
    bytes.append(inout l, lit(" -> "))
    match json.parse(lit(text)) {
        Ok(d) => {
            let es = schema.validate(s, d)
            if es.len() == 0 { bytes.append(inout l, lit("ok")) }
            for i in 0..es.len() {
                if i > 0 { bytes.append(inout l, lit("; ")) }
                bytes.append(inout l, es[i].name)
                l.push(32)
                bytes.append(inout l, es[i].detail)
            }
        }
        Err(e) => bytes.append(inout l, json.error_text(e))
    }
    io.outln(l)
}

fn text(s: schema.Schema, v: str) uses io {
    let mut l = lit(v)
    bytes.append(inout l, lit(" -> "))
    match schema.check_text(s, lit(v)) {
        Some(why) => bytes.append(inout l, why)
        None => bytes.append(inout l, lit("ok"))
    }
    io.outln(l)
}

fn req(method: str, target: str, body: str) -> http.Request {
    let mut r = http.request(method, lit(target))
    if body.len() > 0 {
        r.body = lit(body)
        r.headers.push(http.Header(lit("content-type"), lit("application/json")))
    }
    r
}

type Pet = { id: i64, name: List[u8], kind: List[u8], tag: Option[List[u8]] }

fn pet_json(p: Pet) -> List[u8] { openapi.obj().int("id", p.id).str("name", p.name).str("kind", p.kind).opt_str("tag", p.tag).done() }

type NewPet = { name: List[u8], kind: List[u8], tag: Option[List[u8]] }

fn new_pet(i: openapi.Input) -> Result[NewPet, problem.ApiError] {
    Ok(NewPet(i.str("name")?, i.opt_str("kind").unwrap_or(lit("cat")), i.opt_str("tag")))
}

fn main() uses io {
    print("-- schemas")
    let mut pet = schema.object().describe("A pet").closed()
    pet = pet.field("id", schema.integer().format("int64").min(1))
    pet = pet.field("name", schema.string().min_length(1).max_length(5))
    pet = pet.prop("kind", schema.string().allow("cat").allow("dog"))
    pet = pet.prop("tag", schema.string().nullable())
    io.outln(schema.to_json(pet))
    io.outln(schema.to_json(schema.array(schema.integer()).min_length(1).max_length(3)))
    io.outln(schema.to_json(schema.string().allow("a").nullable()))
    io.outln(schema.to_json(schema.any().example("{\"x\": [1, true]}")))
    errs(pet, "{\"id\": 1, \"name\": \"Tom\"}")
    errs(pet, "{\"id\": 1, \"name\": \"Tom\", \"kind\": \"dog\", \"tag\": null}")
    errs(pet, "{\"id\": 0, \"name\": \"\", \"kind\": \"cow\", \"tag\": 3, \"x\": 1}")
    errs(pet, "{}")
    errs(pet, "[]")
    errs(pet, "{\"id\": 1.5, \"name\": \"Tomasz\"}")
    errs(pet, "{\"id\": 99999999999999999999, \"name\": \"ééééé\"}")
    errs(pet, "{\"id\": \"1\", \"name\": true}")
    let list = schema.array(pet).max_length(1)
    errs(list, "[{\"id\": 1, \"name\": \"a\"}, {\"id\": -1, \"name\": \"b/~\", \"a/b\": 0}]")
    errs(list, "null")
    errs(schema.array(schema.boolean()).nullable(), "null")
    errs(schema.array(schema.boolean()).nullable(), "[true, 1]")
    let refd = schema.ref_to(lit("Pet"), pet)
    io.outln(schema.to_json(refd))
    io.outln(schema.to_json(refd.nullable()))
    errs(refd, "{\"id\": 2}")
    errs(refd.nullable(), "null")
    let lim = schema.integer().min(1).max(100)
    text(lim, "10")
    text(lim, "0")
    text(lim, "101")
    text(lim, "-")
    text(lim, "+5")
    text(lim, "1x")
    text(schema.integer(), "-9223372036854775808")
    text(schema.integer(), "9223372036854775807")
    text(schema.integer(), "9223372036854775808")
    text(schema.integer(), "-9223372036854775809")
    text(schema.boolean(), "true")
    text(schema.boolean(), "yes")
    text(schema.string().allow("asc").allow("desc"), "up")
    print(schema.scalars(lit("hé!")))

    print("-- operations")
    io.outln(openapi.pattern(lit("/pets/{id}/toys/{toy}")))
    io.outln(openapi.pattern(lit("/")))

    print("-- a service")
    let mut svc = openapi.service("Pets", "2.0.0")
    svc.describe("A test service")
    let pet_ref = svc.component("Pet", pet)
    let mut table: List[(List[u8], List[u8])] = List.new()
    table.push((lit("tok"), lit("ann")))
    svc.bearer_auth("bearerAuth", |t: List[u8]| -> Option[List[u8]] {
        if bytes.eq(t, lit("tok")) { return Some(lit("ann")) }
        None
    })
    let mut list_op = openapi.op("GET", "/pets").operation_id("listPets").summary("List pets").tag("pets")
    list_op = list_op.query("limit", schema.integer().min(1).max(10), "At most this many")
    list_op = list_op.query("kind", schema.string().allow("cat").allow("dog"), "")
    list_op = list_op.query_required("owner", schema.string(), "Whose pets")
    list_op = list_op.returns(200, "The pets", schema.array(pet_ref))
    svc.add(list_op, |i: openapi.Input| -> http.Response {
            let mut b = lit("owner=")
            bytes.append(inout b, i.query("owner").unwrap())
            let lim = i.query_int("limit").unwrap()
            bytes.append(inout b, lit(" limit="))
            match lim {
                Some(n) => bytes.append(inout b, bytes.from_i64(n))
                None => bytes.append(inout b, lit("none"))
            }
            http.respond(200, "text/plain", b)
        })
    let mut np = schema.object().closed().field("name", schema.string().min_length(1))
    np = np.prop("kind", schema.string().allow("cat").allow("dog")).prop("tag", schema.string().nullable())
    let create_op = openapi.op("POST", "/pets").operation_id("createPet").secured("bearerAuth").max_body(64).body(np, "The new pet").returns(201, "Created", pet_ref)
    svc.add(create_op, openapi.typed(new_pet, |n: NewPet| -> Result[Pet, problem.ApiError] {
            if bytes.eq(n.name, lit("taken")) { return Err(problem.conflict("that name is taken")) }
            Ok(Pet(7, n.name, n.kind, n.tag))
        }, pet_json))
    let get_op = openapi.op("GET", "/pets/{id}").operation_id("getPet").path_param("id", schema.integer().min(1)).returns(200, "The pet", pet_ref).fails(404, "No such pet")
    svc.add(get_op, openapi.typed(|i: openapi.Input| -> Result[i64, problem.ApiError] { i.path_int("id") }, |id: i64| -> Result[Pet, problem.ApiError] {
            if id != 7 { return Err(problem.not_found("no such pet")) }
            Ok(Pet(7, lit("Tom"), lit("cat"), None))
        }, pet_json))
    let del_op = openapi.op("DELETE", "/pets/{id}").operation_id("deletePet").path_param("id", schema.integer()).returns_empty(204, "Deleted")
    svc.add(del_op, openapi.typed(openapi.no_input, |b: bool| -> Result[bool, problem.ApiError] { Ok(true) }, openapi.no_output))
    svc.raw("GET", "/health", |q: http.Request| -> http.Response { http.text(200, "ok") })
    let h = svc.handler()
    show(h(req("GET", "/pets?owner=me&limit=3", "")))
    show(h(req("GET", "/pets?owner=me", "")))
    show(h(req("GET", "/pets?limit=11&kind=cow", "")))
    show(h(req("GET", "/pets?owner=a+b&limit=x", "")))
    show(h(req("GET", "/pets/7", "")))
    show(h(req("GET", "/pets/8", "")))
    show(h(req("GET", "/pets/0", "")))
    show(h(req("GET", "/pets/abc", "")))
    show(h(req("DELETE", "/pets/3", "")))
    let mut auth = req("POST", "/pets", "{\"name\": \"Rex\", \"kind\": \"dog\"}")
    show(h(auth))
    auth.headers.push(http.Header(lit("authorization"), lit("Bearer tok")))
    show(h(auth))
    let mut bad = auth.copy()
    bad.body = lit("{\"name\": \"\", \"kind\": \"cow\", \"age\": 3}")
    show(h(bad))
    bad.body = lit("{\"name\": ")
    show(h(bad))
    bad.body = lit("{\"name\": \"taken\", \"tag\": null}")
    show(h(bad))
    bad.body = List.new()
    show(h(bad))
    bad.body = lit("{\"name\": \"this body is longer than sixty-four bytes, which is the limit\"}")
    show(h(bad))
    let mut plain = auth.copy()
    plain.headers = http.without(plain.headers, lit("content-type"))
    plain.headers.push(http.Header(lit("content-type"), lit("text/plain")))
    show(h(plain))
    show(h(req("GET", "/health", "")))
    let docr = h(req("GET", "/openapi.json", ""))
    print(docr.status)
    io.outln(docr.header("content-type").unwrap())
    let d = json.parse(docr.body).unwrap()
    io.outln(openapi.pretty(d, d.root))
}
