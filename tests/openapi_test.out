-- schemas
{"type":"object","description":"A pet","properties":{"id":{"type":"integer","format":"int64","minimum":1},"name":{"type":"string","minLength":1,"maxLength":5},"kind":{"type":"string","enum":["cat","dog"]},"tag":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["id","name"],"additionalProperties":false}
{"type":"array","items":{"type":"integer"},"minItems":1,"maxItems":3}
{"anyOf":[{"type":"string","enum":["a"]},{"type":"null"}]}
{"examples":[{"x":[1,true]}]}
{"id": 1, "name": "Tom"} -> ok
{"id": 1, "name": "Tom", "kind": "dog", "tag": null} -> ok
{"id": 0, "name": "", "kind": "cow", "tag": 3, "x": 1} -> #/id must be at least 1; #/name must not be empty; #/kind must be one of "cat", "dog"; #/tag must be a string or null; #/x is not allowed here
{} -> #/id is required; #/name is required
[] -> # must be an object
{"id": 1.5, "name": "Tomasz"} -> #/id must be an integer; #/name must have at most 5 characters
{"id": 99999999999999999999, "name": "ééééé"} -> #/id is out of range (a 64-bit integer)
{"id": "1", "name": true} -> #/id must be an integer; #/name must be a string
[{"id": 1, "name": "a"}, {"id": -1, "name": "b/~", "a/b": 0}] -> # must have at most 1 item; #/1/id must be at least 1; #/1/a~1b is not allowed here
null -> # must be an array
null -> ok
[true, 1] -> #/1 must be true or false
{"$ref":"#/components/schemas/Pet"}
{"anyOf":[{"$ref":"#/components/schemas/Pet"},{"type":"null"}]}
{"id": 2} -> #/name is required
null -> ok
10 -> ok
0 -> must be at least 1
101 -> must be at most 100
- -> must be an integer
+5 -> must be an integer
1x -> must be an integer
-9223372036854775808 -> ok
9223372036854775807 -> ok
9223372036854775808 -> must be an integer
-9223372036854775809 -> must be an integer
true -> ok
yes -> must be true or false
up -> must be one of "asc", "desc"
3
-- operations
/pets/:id/toys/:toy
/
-- a service
200 Content-Type=text/plain | owner=me limit=3
200 Content-Type=text/plain | owner=me limit=none
400 Content-Type=application/problem+json | {"type":"about:blank","title":"Bad Request","status":400,"detail":"the request does not match the API description","errors":[{"in":"query","name":"limit","detail":"must be at most 10"},{"in":"query","name":"kind","detail":"must be one of \"cat\", \"dog\""},{"in":"query","name":"owner","detail":"is required"}]}
400 Content-Type=application/problem+json | {"type":"about:blank","title":"Bad Request","status":400,"detail":"the request does not match the API description","errors":[{"in":"query","name":"limit","detail":"must be an integer"}]}
200 Content-Type=application/json | {"id":7,"name":"Tom","kind":"cat","tag":null}
404 Content-Type=application/problem+json | {"type":"about:blank","title":"Not Found","status":404,"detail":"no such pet"}
400 Content-Type=application/problem+json | {"type":"about:blank","title":"Bad Request","status":400,"detail":"the request does not match the API description","errors":[{"in":"path","name":"id","detail":"must be at least 1"}]}
400 Content-Type=application/problem+json | {"type":"about:blank","title":"Bad Request","status":400,"detail":"the request does not match the API description","errors":[{"in":"path","name":"id","detail":"must be an integer"}]}
204 | 
401 Content-Type=application/problem+json WWW-Authenticate=Bearer realm="Pets" | {"type":"about:blank","title":"Unauthorized","status":401,"detail":"this operation needs a bearer token"}
201 Content-Type=application/json | {"id":7,"name":"Rex","kind":"dog","tag":null}
400 Content-Type=application/problem+json | {"type":"about:blank","title":"Bad Request","status":400,"detail":"the request does not match the API description","errors":[{"in":"body","pointer":"#/name","detail":"must not be empty"},{"in":"body","pointer":"#/kind","detail":"must be one of \"cat\", \"dog\""},{"in":"body","pointer":"#/age","detail":"is not allowed here"}]}
400 Content-Type=application/problem+json | {"type":"about:blank","title":"Bad Request","status":400,"detail":"the request does not match the API description","errors":[{"in":"body","pointer":"#","detail":"is not JSON: unexpected end of input, expected a value at line 1, column 10 (byte 9)"}]}
409 Content-Type=application/problem+json | {"type":"about:blank","title":"Conflict","status":409,"detail":"that name is taken"}
400 Content-Type=application/problem+json | {"type":"about:blank","title":"Bad Request","status":400,"detail":"the request does not match the API description","errors":[{"in":"body","pointer":"#","detail":"a JSON body is required"}]}
413 Content-Type=application/problem+json | {"type":"about:blank","title":"Content Too Large","status":413,"detail":"the body is 73 bytes; this route takes at most 64"}
