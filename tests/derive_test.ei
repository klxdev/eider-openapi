// openapi/derive: schemas derived from types (records, enums, @[json] attributes, nesting) and
// checked against what json.to_bytes writes for the same values.

import core.sys
import std.bytes
import std.io
import std.serial
import json
import openapi.schema
import openapi.derive

@[derive(Serialize, Deserialize, Schematic), serial(rename_all = "camelCase")]
type Todo = {
    @[serial(name = "id")] todo_id: i64,
    title: String,
    note: Option[String],
    done: bool,
    tags: List[String],
    @[serial(default)] priority: i32,
    @[serial(skip)] cache: List[u8],
    @[json(flatten)] meta: Meta,
}

@[derive(Serialize, Deserialize, Schematic)]
type Meta = { created: i64, @[serial(name = "by")] author: String }

@[derive(Serialize, Deserialize, Schematic), serial(tag = "kind", rename_all = "snake_case")]
type Shape =
    | Circle(radius: i64)
    | @[serial(name = "box")] Rect(w: i64, h: i64)
    | Empty
    | Dot


@[derive(Serialize, Deserialize, Schematic)]
type Level = | Low | High

@[derive(Serialize, Deserialize, Schematic), json(unknown = "ignore")]
type Loose = { level: Level, shapes: List[Shape], extra: Map[String, u8] }

// @[check(...)] rules: the schema carries them and the decoder enforces them
@[derive(Serialize, Deserialize, Schematic)]
type Product = {
    @[check(min_len = 3, max_len = 12)] sku: String,
    @[check(min = 1, max = 99)] qty: u32,
    @[check(min = 0)] price_cents: i64,
    @[check(format = "email")] contact: Option[String],
    @[check(one_of = "low,high")] priority: String,
    @[check(min_len = 1, max_len = 3)] tags: List[String],
    @[check(min = 0, max = 9)] digits: List[i32],
}

fn agree(text: str) uses io {
    let s = Product.json_schema()
    let d = json.parse(sys.lit(text)).unwrap()
    let es = schema.validate(s, d)
    let mut l = sys.lit("schema: ")
    if es.len() == 0 { bytes.append(inout l, sys.lit("ok")) }
    for i in 0..es.len() {
        if i > 0 { bytes.append(inout l, sys.lit("; ")) }
        bytes.append(inout l, es[i].name)
        l.push(32)
        bytes.append(inout l, es[i].detail)
    }
    io.outln(l)
    let r: Result[Product, serial.Error] = json.from_bytes(sys.lit(text))
    match r {
        Ok(_) => print("decoder: ok")
        Err(e) => {
            let mut m = sys.lit("decoder: ")
            bytes.append(inout m, bytes.join(serial.messages(e), sys.lit("; ")))
            io.outln(m)
        }
    }
}

fn show(name: str, s: schema.Schema) uses io {
    print(name)
    io.outln(schema.to_json(s))
}

fn valid[T: serial.Serialize](s: schema.Schema, x: T) uses io {
    let d = json.parse(json.to_bytes(x).unwrap()).unwrap()
    let es = schema.validate(s, d)
    if es.len() == 0 {
        print("valid")
    } else {
        for e in es {
            let mut l = e.name.copy()
            l.push(32)
            bytes.append(inout l, e.detail)
            io.outln(l)
        }
    }
}

fn check(s: schema.Schema, text: str) uses io {
    let mut l = sys.lit(text)
    bytes.append(inout l, sys.lit(" -> "))
    let d = json.parse(sys.lit(text)).unwrap()
    let es = schema.validate(s, d)
    if es.len() == 0 { bytes.append(inout l, sys.lit("ok")) }
    for i in 0..es.len() {
        if i > 0 { bytes.append(inout l, sys.lit("; ")) }
        bytes.append(inout l, json.quote(es[i].name))
        l.push(32)
        bytes.append(inout l, es[i].detail)
    }
    io.outln(l)
}

fn main() uses io {
    show("-- record", Todo.json_schema())
    show("-- enum with fields", Shape.json_schema())
    show("-- string enum", Level.json_schema())
    show("-- ignore unknown, map", Loose.json_schema())
    print("-- values written by the encoder are valid")
    let mut tags: List[String] = List.new()
    tags.push(String.from("a"))
    let t = Todo(1, String.from("x"), None, false, tags, 2, List.new(), Meta(5, String.from("me")))
    valid(Todo.json_schema(), t)
    valid(Shape.json_schema(), Circle(2))
    valid(Shape.json_schema(), Empty)
    valid(Level.json_schema(), High)
    let mut m: Map[String, u8] = Map.new()
    m.insert(String.from("k"), 7)
    let mut shapes: List[Shape] = List.new()
    shapes.push(Rect(1, 2))
    shapes.push(Dot)
    valid(Loose.json_schema(), Loose(Low, shapes, m))
    print("-- values that are not")
    check(Todo.json_schema(), r#"{"id":1,"title":"x","done":false,"tags":[],"created":1,"by":"me"}"#)
    check(Todo.json_schema(), r#"{"id":"1","title":"x","done":false,"tags":[],"created":1,"by":"me","extra":1}"#)
    check(Todo.json_schema(), r#"{"id":1,"title":"x","note":null,"done":false,"tags":[],"priority":3000000000,"created":1,"by":"me"}"#)
    check(Shape.json_schema(), r#"{"kind":"circle","radius":"big"}"#)
    check(Shape.json_schema(), r#"{"kind":"nope"}"#)
    check(Shape.json_schema(), r#""empty""#)
    check(Shape.json_schema(), r#""other""#)
    check(Loose.json_schema(), r#"{"level":"low","shapes":[],"extra":{"a":300},"more":1}"#)
    print("-- check rules: schema")
    show("product", Product.json_schema())
    print("-- check rules: schema and decoder agree")
    agree(r#"{"sku":"abc-1","qty":2,"price_cents":100,"contact":"a@b.co","priority":"low","tags":["x"],"digits":[1,2]}"#)
    agree(r#"{"sku":"ab","qty":0,"price_cents":-1,"contact":"nope","priority":"mid","tags":[],"digits":[1,10]}"#)
    agree(r#"{"sku":"abcdefghijklm","qty":100,"price_cents":5,"contact":null,"priority":"high","tags":["a","b","c","d"],"digits":[-1]}"#)
}
