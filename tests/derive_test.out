-- record
{"type":"object","properties":{"id":{"type":"integer","format":"int64"},"title":{"type":"string"},"note":{"anyOf":[{"type":"string"},{"type":"null"}]},"done":{"type":"boolean"},"tags":{"type":"array","items":{"type":"string"}},"priority":{"type":"integer","format":"int32","minimum":-2147483648,"maximum":2147483647},"created":{"type":"integer","format":"int64"},"by":{"type":"string"}},"required":["id","title","done","tags","created","by"],"additionalProperties":false}
-- enum with fields
{"oneOf":[{"type":"string","enum":["empty","dot"]},{"type":"object","properties":{"kind":{"type":"string","enum":["circle"]},"radius":{"type":"integer","format":"int64"}},"required":["kind","radius"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","enum":["box"]},"w":{"type":"integer","format":"int64"},"h":{"type":"integer","format":"int64"}},"required":["kind","w","h"],"additionalProperties":false}]}
-- string enum
{"type":"string","enum":["Low","High"]}
-- ignore unknown, map
{"type":"object","properties":{"level":{"type":"string","enum":["Low","High"]},"shapes":{"type":"array","items":{"oneOf":[{"type":"string","enum":["empty","dot"]},{"type":"object","properties":{"kind":{"type":"string","enum":["circle"]},"radius":{"type":"integer","format":"int64"}},"required":["kind","radius"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","enum":["box"]},"w":{"type":"integer","format":"int64"},"h":{"type":"integer","format":"int64"}},"required":["kind","w","h"],"additionalProperties":false}]}},"extra":{"type":"object","additionalProperties":{"type":"integer","minimum":0,"maximum":255}}},"required":["level","shapes","extra"]}
