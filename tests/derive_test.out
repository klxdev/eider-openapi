-- values that are not
{"id":1,"title":"x","done":false,"tags":[],"created":1,"by":"me"} -> ok
{"id":"1","title":"x","done":false,"tags":[],"created":1,"by":"me","extra":1} -> "#/id" must be an integer; "#/extra" is not allowed here
{"id":1,"title":"x","note":null,"done":false,"tags":[],"priority":3000000000,"created":1,"by":"me"} -> "#/priority" must be at most 2147483647
{"kind":"circle","radius":"big"} -> "#/radius" must be an integer
{"kind":"nope"} -> "#" does not match any of the allowed shapes
"empty" -> ok
"other" -> "#" must be one of "empty", "dot"
{"level":"low","shapes":[],"extra":{"a":300},"more":1} -> "#/level" must be one of "Low", "High"; "#/extra/a" must be at most 255
