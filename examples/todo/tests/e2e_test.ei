// todo end to end: the example service starts on 127.0.0.1 on an ephemeral port and is
// called over loopback with eider-http's client: CRUD, validation errors (400
// problem+json), authentication (401), media type (415) and body size (413) refusals, the
// router's 404 and 405 as problem+json, CORS, request ids, four clients at once from a task
// group, /metrics, and the served /openapi.json against the recorded golden
// (tests/openapi.golden.json; UPDATE_GOLDEN=1 rewrites it). Then it is shut down through its
// token and the access log is checked. No fixed ports, no sleeps: the server listens before
// its thread starts, and each call waits (with a deadline) for its own response.

import core.sys
import std.bytes
import std.env
import std.fs
import std.io
import std.net
import std.stream
import std.sync
import std.task
import std.testing
import std.time
import json
import http
import http.server
import http.client
import http.middleware
import http.metrics
import openapi
import todo

fn lit(s: str) -> List[u8] { sys.lit(s) }

const TOKEN: str = "test-token"

fn call(inout c: client.Conn, method: str, target: str, body: str, auth: bool, dl: time.Deadline) -> http.Response uses net, io, clock {
    let mut r = http.request(method, lit(target))
    if body.len() > 0 {
        r.body = lit(body)
        r.set_header("Content-Type", lit("application/json"))
    }
    if auth { r.set_header("Authorization", bytes.concat(lit("Bearer "), lit(TOKEN))) }
    match c.request(r, dl) {
        Ok(resp) => resp
        Err(e) => {
            print(e)
            http.response(599)
        }
    }
}

fn show(r: http.Response) uses io {
    let mut l = bytes.from_u64(r.status as u64)
    l.push(32)
    for name in ["content-type", "www-authenticate", "allow", "access-control-allow-origin", "access-control-allow-methods", "access-control-allow-headers", "vary"] {
        match r.header(name) {
            Some(v) => {
                bytes.append(inout l, lit(name))
                l.push(61)
                bytes.append(inout l, v)
                l.push(32)
            }
            None => {}
        }
    }
    bytes.append(inout l, lit("| "))
    bytes.append(inout l, r.body)
    io.outln(l)
}

fn golden_path() -> List[u8] uses fs {
    for p in ["examples/todo/tests/openapi.golden.json", "tests/openapi.golden.json", "openapi.golden.json"] {
        if fs.exists(lit(p)) { return lit(p) }
    }
    lit("examples/todo/tests/openapi.golden.json")
}

fn main() uses io, fs, net, clock, threads {
    let dl = time.after_ms(30000)
    let mut cfg = server.config()
    cfg.workers = 4
    let srv = server.listen(net.ipv4(127, 0, 0, 1, 0), cfg).unwrap()
    let addr = srv.addr()
    print(addr.port > 0)

    let log = sync.lock(stream.buffer())
    let m = metrics.new()
    let mut table: List[(List[u8], List[u8])] = List.new()
    table.push((lit(TOKEN), lit("tester")))
    let pool = task.pool(2, 8)
    let parts = todo.Parts(log, m, middleware.ids("req"), middleware.cors_config().allow_origin("https://app.example"), pool)
    let h = todo.app(todo.store(), middleware.token_table(table), parts)
    let tok = task.root()
    let t = tok
    let running = spawn(|| -> server.Stats { srv.serve(h, t).unwrap() })

    let mut c = client.connect(addr, dl).unwrap()
    print("-- create")
    show(call(inout c, "GET", "/health", "", false, dl))
    show(call(inout c, "POST", "/todos", "{\"title\": \"write docs\"}", false, dl))
    show(call(inout c, "POST", "/todos", "{\"title\": \"write docs\"}", true, dl))
    show(call(inout c, "POST", "/todos", "{\"title\": \"ship it\", \"priority\": \"high\", \"note\": \"after the docs\"}", true, dl))
    show(call(inout c, "POST", "/todos", "{\"title\": \"tidy up\", \"priority\": \"low\", \"note\": null}", true, dl))

    print("-- refused")
    show(call(inout c, "POST", "/todos", "{\"title\": \"\", \"priority\": \"urgent\", \"done\": true}", true, dl))
    show(call(inout c, "POST", "/todos", "{\"title\": 7", true, dl))
    show(call(inout c, "POST", "/todos", "", true, dl))
    let mut plain = http.request("POST", lit("/todos"))
    plain.body = lit("title=x")
    plain.set_header("Content-Type", lit("application/x-www-form-urlencoded"))
    plain.set_header("Authorization", bytes.concat(lit("Bearer "), lit(TOKEN)))
    show(c.request(plain, dl).unwrap())
    let mut big = plain.copy()
    big.headers = http.without(big.headers, lit("content-type"))
    big.set_header("Content-Type", lit("application/json"))
    let mut long = lit("{\"title\": \"")
    for k in 0..5000 { long.push(120) }
    bytes.append(inout long, lit("\"}"))
    big.body = long
    let br = c.request(big, dl).unwrap()
    print(br.status)
    io.outln(br.body)
    let mut wrong = plain.copy()
    wrong.headers = http.without(wrong.headers, lit("authorization"))
    wrong.set_header("Authorization", lit("Bearer nope"))
    show(c.request(wrong, dl).unwrap())

    print("-- read")
    show(call(inout c, "GET", "/todos", "", false, dl))
    show(call(inout c, "GET", "/todos?done=false&limit=2", "", false, dl))
    show(call(inout c, "GET", "/todos?priority=high", "", false, dl))
    show(call(inout c, "GET", "/todos?limit=0&done=maybe&priority=urgent", "", false, dl))
    show(call(inout c, "GET", "/todos/1", "", false, dl))
    show(call(inout c, "GET", "/todos/99", "", false, dl))
    show(call(inout c, "GET", "/todos/x", "", false, dl))

    print("-- update and delete")
    show(call(inout c, "PATCH", "/todos/2", "{\"done\": true, \"note\": null}", true, dl))
    show(call(inout c, "PATCH", "/todos/2", "{\"done\": \"yes\", \"colour\": \"red\"}", true, dl))
    show(call(inout c, "PATCH", "/todos/1", "{\"title\": \"write the docs\", \"note\": \"today\"}", true, dl))
    show(call(inout c, "PATCH", "/todos/42", "{\"done\": true}", true, dl))
    show(call(inout c, "DELETE", "/todos/3", "", false, dl))
    show(call(inout c, "DELETE", "/todos/3", "", true, dl))
    show(call(inout c, "DELETE", "/todos/3", "", true, dl))
    show(call(inout c, "GET", "/todos?done=true", "", false, dl))

    print("-- routing errors")
    show(call(inout c, "GET", "/nope", "", false, dl))
    show(call(inout c, "PUT", "/todos", "", false, dl))

    print("-- cors and request ids")
    let mut pre = http.request("OPTIONS", lit("/todos"))
    pre.set_header("Origin", lit("https://app.example"))
    pre.set_header("Access-Control-Request-Method", lit("POST"))
    pre.set_header("Access-Control-Request-Headers", lit("content-type, authorization"))
    show(c.request(pre, dl).unwrap())
    let mut cg = http.request("GET", lit("/todos/1"))
    cg.set_header("Origin", lit("https://app.example"))
    cg.set_header("X-Request-Id", lit("trace-42"))
    let cr = c.request(cg, dl).unwrap()
    show(cr)
    io.outln(cr.header("x-request-id").unwrap())
    let auto = call(inout c, "GET", "/health", "", false, dl).header("x-request-id").unwrap()
    print(bytes.starts_with(auto, lit("req-")))

    print("-- four clients at once")
    let mut g: task.Group[i64] = task.group(tok.child())
    for w in 0..4 {
        let who = w as i64
        g.spawn(|tk: task.Token| -> Result[i64, String] {
            let mut cc = client.connect(addr, tk.bound(dl))?
            let mut made: i64 = 0
            for i in 0..10 {
                let mut r = http.request("POST", lit("/todos"))
                let mut b = lit("{\"title\": \"worker ")
                bytes.append(inout b, bytes.from_i64(who))
                bytes.append(inout b, lit(" item "))
                bytes.append(inout b, bytes.from_i64(i as i64))
                bytes.append(inout b, lit("\"}"))
                r.body = b
                r.set_header("Content-Type", lit("application/json"))
                r.set_header("Authorization", bytes.concat(lit("Bearer "), lit(TOKEN)))
                let resp = cc.request(r, tk.bound(dl))?
                if resp.status == 201 { made += 1 }
            }
            cc.close()
            Ok(made)
        })
    }
    let mut total: i64 = 0
    for n in g.wait().unwrap() { total += n }
    print(total)
    let all = call(inout c, "GET", "/todos?limit=100", "", false, dl)
    let ad = json.parse(all.body).unwrap()
    print(json.len(ad, ad.root))

    print("-- metrics")
    let mr = call(inout c, "GET", "/metrics", "", false, dl)
    io.outln(mr.header("content-type").unwrap())
    for l in bytes.lines(mr.body) {
        if bytes.starts_with(l, lit("http_requests_total")) || bytes.starts_with(l, lit("http_request_duration_seconds_count")) || bytes.starts_with(l, lit("# TYPE")) {
            io.outln(l)
        }
    }

    print("-- openapi.json")
    let dr = call(inout c, "GET", "/openapi.json", "", false, dl)
    print(dr.status)
    let dd = json.parse(dr.body).unwrap()
    let mut got = openapi.pretty(dd, dd.root)
    got.push(10)
    let gp = golden_path()
    match env.get(lit("UPDATE_GOLDEN")) {
        Some(v) => {
            fs.write(gp, got).unwrap()
            print("golden rewritten")
        }
        None => {}
    }
    let want = fs.read(gp).unwrap_or(List.new())
    if bytes.eq(got, want) {
        print("served /openapi.json matches tests/openapi.golden.json")
    } else {
        print("served /openapi.json differs from tests/openapi.golden.json:")
        io.outln(testing.diff_lines(sys.to_string(want), sys.to_string(got)).bytes())
    }
    c.close()

    print("-- shutdown")
    tok.cancel()
    let st = running.join()
    print(st.requests)
    print(st.bad)
    print(client.get(addr, "/health", dl).is_err())
    pool.shutdown()

    print("-- access log")
    let lines = bytes.lines(log.get().bytes())
    print(lines.len() as i64 == st.requests)
    let first = json.parse(lines[0]).unwrap()
    for k in ["id", "method", "path", "status"] {
        let mut o = lit(k)
        o.push(61)
        bytes.append(inout o, json.write(first, json.field(first, first.root, k).unwrap()))
        io.outln(o)
    }
    let mut principals: i64 = 0
    for l in lines {
        let d = json.parse(l).unwrap()
        if json.field(d, d.root, "principal").is_some() { principals += 1 }
        if !bytes.starts_with(json.as_str(d, json.field(d, d.root, "peer").unwrap()).unwrap(), lit("127.0.0.1:")) { print("a line without the peer") }
    }
    print(principals)
}
