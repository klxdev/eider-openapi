// todo: run the example service (todo.ei) on 127.0.0.1.
//
//   TODO_TOKEN=secret scripts/ei run examples/todo/main.ei [port]   (default 8080; 0: any)
//   curl -s localhost:8080/openapi.json
//   curl -s localhost:8080/todos -H 'Authorization: Bearer secret' \
//        -H 'Content-Type: application/json' -d '{"title": "write docs"}'
//   curl -s localhost:8080/metrics
//
// Without TODO_TOKEN a random token is made and printed. Access-log lines (JSON) go to
// stdout. SIGTERM or SIGINT shuts it down gracefully. Plain HTTP only: put it behind a
// TLS-terminating proxy to expose it (eider-http's docs/services.md "Security posture").

import "core/sys"
import "std/bytes"
import "std/encoding"
import "std/env"
import "std/fd"
import "std/io"
import "std/net"
import "std/random"
import "std/signal"
import "std/stream"
import "std/sync"
import "std/task"
import "std/time"
import "http/server"
import "http/middleware"
import "http/metrics"
import "todo.ei"

fn port_arg() -> i32 uses io {
    let a = env.args()
    if a.len() < 2 { return 8080 }
    match bytes.parse_u64(a[1]) {
        Some(p) => {
            if p > 65535 {
                io.errln(sys.lit("todo: the port is 0 to 65535"))
                env.exit(2)
            }
            p as i32
        }
        None => {
            io.errln(sys.lit("usage: todo [port]"))
            env.exit(2)
            0
        }
    }
}

fn token() -> List[u8] uses io {
    match env.get(sys.lit("TODO_TOKEN")) {
        Some(t) => {
            if t.len() > 0 { return t }
        }
        None => {}
    }
    let t = encoding.hex(random.bytes(16).unwrap()).bytes()
    io.errln(bytes.concat(sys.lit("todo: TODO_TOKEN is not set; the token is "), t))
    t
}

fn main() uses io, net, clock, threads {
    let srv = match server.listen(net.ipv4(127, 0, 0, 1, port_arg()), server.config()) {
        Ok(s) => s
        Err(e) => {
            io.errln(e.bytes())
            env.exit(1)
            return
        }
    }
    let mut table: List[(List[u8], List[u8])] = List.new()
    table.push((token(), sys.lit("owner")))
    let parts = todo.Parts(sync.lock(stream.stdout()), metrics.new(), middleware.random_ids().unwrap(), middleware.cors_config().allow_origin("http://localhost:3000"), task.pool(4, 16))
    let h = todo.app(todo.store(), middleware.token_table(table), parts)
    let mut l = sys.lit("todo: listening on http://")
    bytes.append(inout l, net.text(srv.addr()))
    io.errln(l)

    // TERM and INT arrive on the signal pipe; a thread waits for one and cancels the server
    let tok = task.root()
    signal.watch(signal.TERM).unwrap()
    signal.watch(signal.INT).unwrap()
    let sig_fd = signal.events_fd().unwrap()
    let t = tok
    let waiter = spawn(|| -> i32 {
        let mut going = true
        while going {
            match fd.wait_ready(sig_fd, fd.READY_READ, t.deadline()) {
                Ok(true) => {
                    if signal.pending().unwrap_or(List.new()).len() > 0 { going = false }
                }
                Ok(false) => { going = false }
                Err(e) => { going = false }
            }
        }
        t.cancel()
        0
    })
    match srv.serve(h, tok) {
        Ok(st) => {
            let mut m = String.from("todo: stopped after ")
            m.append(String.from_int(st.requests))
            m.push_str(" requests on ")
            m.append(String.from_int(st.connections))
            m.push_str(" connections")
            io.errln(m.bytes())
        }
        Err(e) => io.errln(e.bytes())
    }
    let z = waiter.join()
}
