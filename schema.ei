//! openapi/schema: the JSON Schema subset (2020-12, the dialect of OpenAPI 3.1) that services
//! need, as values: build one, render it as JSON (packages/json), and validate JSON values and
//! parameter text against it.
//!
//!     let mut todo = schema.object().closed()                    // no other members
//!     todo = todo.field("id", schema.integer().format("int64"))   // required
//!     todo = todo.field("title", schema.string().min_length(1).max_length(200))
//!     todo = todo.prop("note", schema.string().nullable())        // optional
//!     todo = todo.prop("priority", schema.string().allow("low").allow("high"))
//!
//! Kinds: object (properties, required, additionalProperties false with `closed`), array
//! (items, minItems/maxItems), string (minLength/maxLength in Unicode scalars, enum, format),
//! integer (minimum/maximum; JSON integers in i64's range, so `1.0` and `1e3` are not
//! integers here), boolean, any (`{}`), and a reference to a named component (`ref`, rendered
//! as `{"$ref": "#/components/schemas/<name>"}`; it carries the schema it names, so
//! validating needs no lookup). `nullable` adds null as a valid value, written as
//! `{"anyOf": [<schema>, {"type": "null"}]}` (3.1 has no `nullable` keyword).
//!
//! Validation collects every error (up to MAX_ERRORS) as `problem.FieldError`s with a JSON
//! pointer, so a 400 can say everything that was wrong at once.

import "core/sys"
import "std/bytes"
import "json"
import "http/problem"

pub const ANY: i32 = 0
pub const OBJECT: i32 = 1
pub const ARRAY: i32 = 2
pub const STRING: i32 = 3
pub const INTEGER: i32 = 4
pub const BOOLEAN: i32 = 5
pub const REF: i32 = 6

/// Validation stops collecting errors after this many.
pub const MAX_ERRORS: usize = 20

pub type Prop = { name: List[u8], schema: Schema }

/// A schema (see the module comment). `min_len`/`max_len` are -1 when unset (strings: length
/// in scalars; arrays: number of items). `items` holds the element schema of an ARRAY and the
/// named schema of a REF. `choices` is a string enum. `example` is JSON text.
pub type Schema = {
    kind: i32,
    desc: List[u8],
    props: List[Prop],
    required: List[List[u8]],
    closed: bool,
    items: List[Schema],
    choices: List[List[u8]],
    nullable: bool,
    min_len: i64,
    max_len: i64,
    minimum: Option[i64],
    maximum: Option[i64],
    format: List[u8],
    name: List[u8],
    example: List[u8],
}

fn of(kind: i32) -> Schema {
    Schema(kind, List.new(), List.new(), List.new(), false, List.new(), List.new(), false, -1, -1, None, None, List.new(), List.new(), List.new())
}

pub fn any() -> Schema { of(ANY) }
pub fn object() -> Schema { of(OBJECT) }
pub fn string() -> Schema { of(STRING) }
pub fn integer() -> Schema { of(INTEGER) }
pub fn boolean() -> Schema { of(BOOLEAN) }

pub fn array(items: Schema) -> Schema {
    let mut s = of(ARRAY)
    s.items.push(items)
    s
}

/// A reference to component `name` whose schema is `target` (openapi.Service.component makes
/// these).
pub fn ref_to(name: List[u8], target: Schema) -> Schema {
    let mut s = of(REF)
    s.name = name
    s.items.push(target)
    s
}

impl Schema {
    fn describe(self, text: str) -> Schema {
        let mut s = self.copy()
        s.desc = sys.lit(text)
        s
    }

    /// An optional property.
    fn prop(self, name: str, p: Schema) -> Schema {
        let mut s = self.copy()
        s.props.push(Prop(sys.lit(name), p))
        s
    }

    /// A required property.
    fn field(self, name: str, p: Schema) -> Schema {
        let mut s = self.prop(name, p)
        s.required.push(sys.lit(name))
        s
    }

    /// No members other than the properties (`additionalProperties: false`).
    fn closed(self) -> Schema {
        let mut s = self.copy()
        s.closed = true
        s
    }

    /// One more allowed value of a string enum.
    fn allow(self, v: str) -> Schema {
        let mut s = self.copy()
        s.choices.push(sys.lit(v))
        s
    }

    fn nullable(self) -> Schema {
        let mut s = self.copy()
        s.nullable = true
        s
    }

    fn min_length(self, n: i64) -> Schema {
        let mut s = self.copy()
        s.min_len = n
        s
    }

    fn max_length(self, n: i64) -> Schema {
        let mut s = self.copy()
        s.max_len = n
        s
    }

    fn min(self, n: i64) -> Schema {
        let mut s = self.copy()
        s.minimum = Some(n)
        s
    }

    fn max(self, n: i64) -> Schema {
        let mut s = self.copy()
        s.maximum = Some(n)
        s
    }

    /// A `format` annotation ("int64", "date-time", ...): documented, not validated.
    fn format(self, f: str) -> Schema {
        let mut s = self.copy()
        s.format = sys.lit(f)
        s
    }

    /// An example value (JSON text).
    fn example(self, json_text: str) -> Schema {
        let mut s = self.copy()
        s.example = sys.lit(json_text)
        s
    }

    /// The schema a REF names (itself for any other kind).
    fn target(self) -> Schema {
        if self.kind == REF { return self.items[0].target() }
        self
    }

    /// The property `name`, if it is one.
    fn property(self, name: List[u8]) -> Option[Schema] {
        let t = self.target()
        for p in t.props {
            if bytes.eq(p.name, name) { return Some(p.schema) }
        }
        None
    }
}

// ---- rendering

fn type_name(kind: i32) -> str {
    match kind {
        1 => "object"
        2 => "array"
        3 => "string"
        4 => "integer"
        5 => "boolean"
        _ => ""
    }
}

/// The schema as a node of `d` (children are added first, as json's builder wants).
pub fn emit(inout d: json.Doc, s: Schema) -> u32 {
    let inner = emit_plain(inout d, s)
    if !s.nullable { return inner }
    let mut nk: List[List[u8]] = List.new()
    nk.push(sys.lit("type"))
    let mut nv: List[u32] = List.new()
    nv.push(json.new_string(inout d, sys.lit("null")))
    let null_node = json.new_object(inout d, nk, nv)
    let mut alts: List[u32] = List.new()
    alts.push(inner)
    alts.push(null_node)
    let any_of = json.new_array(inout d, alts)
    let mut ks: List[List[u8]] = List.new()
    ks.push(sys.lit("anyOf"))
    let mut vs: List[u32] = List.new()
    vs.push(any_of)
    json.new_object(inout d, ks, vs)
}

fn emit_plain(inout d: json.Doc, s: Schema) -> u32 {
    let mut ks: List[List[u8]] = List.new()
    let mut vs: List[u32] = List.new()
    if s.kind == REF {
        let mut r = sys.lit("#/components/schemas/")
        bytes.append(inout r, s.name)
        ks.push(sys.lit("$ref"))
        vs.push(json.new_string(inout d, r))
        if s.desc.len() > 0 {
            ks.push(sys.lit("description"))
            vs.push(json.new_string(inout d, s.desc))
        }
        return json.new_object(inout d, ks, vs)
    }
    if s.kind != ANY {
        ks.push(sys.lit("type"))
        vs.push(json.new_string(inout d, sys.lit(type_name(s.kind))))
    }
    if s.desc.len() > 0 {
        ks.push(sys.lit("description"))
        vs.push(json.new_string(inout d, s.desc))
    }
    if s.format.len() > 0 {
        ks.push(sys.lit("format"))
        vs.push(json.new_string(inout d, s.format))
    }
    if s.kind == OBJECT {
        let mut pk: List[List[u8]] = List.new()
        let mut pv: List[u32] = List.new()
        for p in s.props {
            pk.push(p.name)
            pv.push(emit(inout d, p.schema))
        }
        ks.push(sys.lit("properties"))
        vs.push(json.new_object(inout d, pk, pv))
        if s.required.len() > 0 {
            let mut rs: List[u32] = List.new()
            for r in s.required { rs.push(json.new_string(inout d, r)) }
            ks.push(sys.lit("required"))
            vs.push(json.new_array(inout d, rs))
        }
        if s.closed {
            ks.push(sys.lit("additionalProperties"))
            vs.push(json.new_bool(inout d, false))
        }
    }
    if s.kind == ARRAY {
        ks.push(sys.lit("items"))
        vs.push(emit(inout d, s.items[0]))
    }
    if s.choices.len() > 0 {
        let mut es: List[u32] = List.new()
        for c in s.choices { es.push(json.new_string(inout d, c)) }
        ks.push(sys.lit("enum"))
        vs.push(json.new_array(inout d, es))
    }
    let arr = s.kind == ARRAY
    let lo = if arr { "minItems" } else { "minLength" }
    let hi = if arr { "maxItems" } else { "maxLength" }
    if s.min_len >= 0 {
        ks.push(sys.lit(lo))
        vs.push(json.new_int(inout d, s.min_len))
    }
    if s.max_len >= 0 {
        ks.push(sys.lit(hi))
        vs.push(json.new_int(inout d, s.max_len))
    }
    match s.minimum {
        Some(n) => {
            ks.push(sys.lit("minimum"))
            vs.push(json.new_int(inout d, n))
        }
        None => {}
    }
    match s.maximum {
        Some(n) => {
            ks.push(sys.lit("maximum"))
            vs.push(json.new_int(inout d, n))
        }
        None => {}
    }
    if s.example.len() > 0 {
        match json.parse(s.example) {
            Ok(ex) => {
                ks.push(sys.lit("examples"))
                let mut one: List[u32] = List.new()
                one.push(copy_node(inout d, ex, ex.root))
                vs.push(json.new_array(inout d, one))
            }
            Err(e) => panic("schema: an example is not JSON")
        }
    }
    json.new_object(inout d, ks, vs)
}

/// Node `id` of `src` copied into `d`.
pub fn copy_node(inout d: json.Doc, src: json.Doc, id: u32) -> u32 {
    let k = json.kind(src, id)
    if k == json.NULL { return json.new_null(inout d) }
    if k == json.BOOL { return json.new_bool(inout d, json.as_bool(src, id).unwrap()) }
    if k == json.NUMBER { return json.new_number(inout d, json.num_text(src, id).unwrap()).unwrap() }
    if k == json.STRING { return json.new_string(inout d, json.as_str(src, id).unwrap()) }
    if k == json.ARRAY {
        let mut xs: List[u32] = List.new()
        for i in 0..json.len(src, id) { xs.push(copy_node(inout d, src, json.at(src, id, i).unwrap())) }
        return json.new_array(inout d, xs)
    }
    let mut ks: List[List[u8]] = List.new()
    let mut vs: List[u32] = List.new()
    for i in 0..json.len(src, id) {
        ks.push(json.as_str(src, json.key_at(src, id, i).unwrap()).unwrap())
        vs.push(copy_node(inout d, src, json.val_at(src, id, i).unwrap()))
    }
    json.new_object(inout d, ks, vs)
}

/// The schema as compact JSON text.
pub fn to_json(s: Schema) -> List[u8] {
    let mut d = json.new_doc()
    let root = emit(inout d, s)
    json.write(d, root)
}

// ---- validation

/// Unicode scalars in UTF-8 text (bytes that don't continue a sequence).
pub fn scalars(s: List[u8]) -> i64 {
    let mut n: i64 = 0
    for c in s {
        if (c & 192) != 128 { n += 1 }
    }
    n
}

fn add(inout errs: List[problem.FieldError], path: List[List[u8]], detail: List[u8]) {
    if errs.len() < MAX_ERRORS { errs.push(problem.FieldError(sys.lit("body"), problem.pointer(path), detail)) }
}

fn msg(a: str, n: i64, b: str) -> List[u8] {
    let mut m = sys.lit(a)
    bytes.append(inout m, bytes.from_i64(n))
    bytes.append(inout m, sys.lit(b))
    m
}

/// "must have at least 2 items" / "1 item".
fn count_msg(a: str, n: i64, what: str) -> List[u8] {
    let mut m = msg(a, n, " ")
    bytes.append(inout m, sys.lit(what))
    if n != 1 { m.push(115) }
    m
}

/// "one of \"a\", \"b\"".
fn choices_text(cs: List[List[u8]]) -> List[u8] {
    let mut m = sys.lit("must be one of ")
    for i in 0..cs.len() {
        if i > 0 { bytes.append(inout m, sys.lit(", ")) }
        json.quote_into(inout m, cs[i])
    }
    m
}

/// What is wrong with a string `v` for `s` (a string schema), or None.
fn check_string(s: Schema, v: List[u8]) -> Option[List[u8]] {
    if s.choices.len() > 0 {
        let mut found = false
        for c in s.choices {
            if bytes.eq(c, v) { found = true }
        }
        if !found { return Some(choices_text(s.choices)) }
    }
    let n = scalars(v)
    if s.min_len >= 0 && n < s.min_len {
        if s.min_len == 1 { return Some(sys.lit("must not be empty")) }
        return Some(count_msg("must have at least ", s.min_len, "character"))
    }
    if s.max_len >= 0 && n > s.max_len { return Some(count_msg("must have at most ", s.max_len, "character")) }
    None
}

fn check_int(s: Schema, v: i64) -> Option[List[u8]] {
    match s.minimum {
        Some(lo) => {
            if v < lo { return Some(msg("must be at least ", lo, "")) }
        }
        None => {}
    }
    match s.maximum {
        Some(hi) => {
            if v > hi { return Some(msg("must be at most ", hi, "")) }
        }
        None => {}
    }
    None
}

/// Validates node `id` of `d` against `s`; errors are added to `errs` with `path` (the
/// tokens of the node's JSON pointer).
pub fn check(s: Schema, d: json.Doc, id: u32, path: List[List[u8]], inout errs: List[problem.FieldError]) {
    let k = json.kind(d, id)
    if s.nullable && k == json.NULL { return }
    if s.kind == REF {
        let mut t = s.items[0].copy()
        t.nullable = t.nullable || s.nullable
        check(t, d, id, path, inout errs)
        return
    }
    if s.kind == ANY { return }
    let null_ok = if s.nullable { " or null" } else { "" }
    if s.kind == OBJECT {
        if k != json.OBJECT {
            add(inout errs, path, bytes.concat(sys.lit("must be an object"), sys.lit(null_ok)))
            return
        }
        for r in s.required {
            if json.get(d, id, r).is_none() {
                let mut p = path.copy()
                p.push(r)
                add(inout errs, p, sys.lit("is required"))
            }
        }
        for i in 0..json.len(d, id) {
            let key = json.as_str(d, json.key_at(d, id, i).unwrap()).unwrap()
            let mut p = path.copy()
            p.push(key)
            let mut known = false
            for prop in s.props {
                if bytes.eq(prop.name, key) {
                    known = true
                    check(prop.schema, d, json.val_at(d, id, i).unwrap(), p, inout errs)
                }
            }
            if !known && s.closed { add(inout errs, p, sys.lit("is not allowed here")) }
        }
        return
    }
    if s.kind == ARRAY {
        if k != json.ARRAY {
            add(inout errs, path, bytes.concat(sys.lit("must be an array"), sys.lit(null_ok)))
            return
        }
        let n = json.len(d, id) as i64
        if s.min_len >= 0 && n < s.min_len { add(inout errs, path, count_msg("must have at least ", s.min_len, "item")) }
        if s.max_len >= 0 && n > s.max_len { add(inout errs, path, count_msg("must have at most ", s.max_len, "item")) }
        for i in 0..json.len(d, id) {
            let mut p = path.copy()
            p.push(bytes.from_u64(i as u64))
            check(s.items[0], d, json.at(d, id, i).unwrap(), p, inout errs)
        }
        return
    }
    if s.kind == STRING {
        match json.as_str(d, id) {
            Some(v) => {
                match check_string(s, v) {
                    Some(m) => add(inout errs, path, m)
                    None => {}
                }
            }
            None => add(inout errs, path, bytes.concat(sys.lit("must be a string"), sys.lit(null_ok)))
        }
        return
    }
    if s.kind == INTEGER {
        match json.as_int(d, id) {
            Some(v) => {
                match check_int(s, v) {
                    Some(m) => add(inout errs, path, m)
                    None => {}
                }
            }
            None => {
                let mut why = sys.lit("must be an integer")
                if k == json.NUMBER {
                    let t = json.num_text(d, id).unwrap()
                    if bytes.find_byte(t, 46, 0).is_none() && bytes.find_byte(t, 101, 0).is_none() && bytes.find_byte(t, 69, 0).is_none() {
                        why = sys.lit("is out of range (a 64-bit integer)")
                    }
                }
                bytes.append(inout why, sys.lit(null_ok))
                add(inout errs, path, why)
            }
        }
        return
    }
    if s.kind == BOOLEAN {
        if k != json.BOOL { add(inout errs, path, bytes.concat(sys.lit("must be true or false"), sys.lit(null_ok))) }
    }
}

/// Validates a whole JSON document: the errors (none: valid).
pub fn validate(s: Schema, d: json.Doc) -> List[problem.FieldError] {
    let mut errs: List[problem.FieldError] = List.new()
    check(s, d, d.root, List.new(), inout errs)
    errs
}

/// A decimal integer in i64's range: an optional `-`, then digits, nothing else.
pub fn parse_int(t: List[u8]) -> Option[i64] {
    if t.len() == 0 || t.len() > 20 { return None }
    let neg = t[0] == 45
    let start: usize = if neg { 1 } else { 0 }
    if start == t.len() { return None }
    // accumulate negatively: -9223372036854775808 has no positive counterpart
    let mut v: i64 = 0
    for i in start..t.len() {
        let c = t[i]
        if !bytes.is_digit(c) { return None }
        let dgt = (c - 48) as i64
        if v < (-9223372036854775807 - 1 + dgt) / 10 { return None }
        v = v * 10 - dgt
    }
    if neg { return Some(v) }
    if v == -9223372036854775807 - 1 { return None }
    Some(-v)
}

/// What is wrong with parameter text `v` for `s` (string, integer, boolean, their enums and
/// bounds), or None. Other kinds are not supported as parameters (a programming error).
pub fn check_text(s: Schema, v: List[u8]) -> Option[List[u8]] {
    let t = s.target()
    if t.kind == STRING { return check_string(t, v) }
    if t.kind == INTEGER {
        return match parse_int(v) {
            Some(n) => check_int(t, n)
            None => Some(sys.lit("must be an integer"))
        }
    }
    if t.kind == BOOLEAN {
        if bytes.eq(v, sys.lit("true")) || bytes.eq(v, sys.lit("false")) { return None }
        return Some(sys.lit("must be true or false"))
    }
    if t.kind == ANY { return None }
    panic("schema: a parameter must be a string, integer or boolean")
}
