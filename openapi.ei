// openapi: an OpenAPI 3.1 service builder over packages/http. A route is registered together
// with its operation (summary, parameters, request and response schemas), and the one
// description drives three things, so they can't drift apart:
//   1. routing: the operation's path (`/todos/{id}`) becomes the router pattern (`/todos/:id`);
//   2. validation: before the handler runs, path and query parameters and the JSON body are
//      checked against their schemas, and a request that doesn't match is answered 400 with
//      problem+json (RFC 9457) listing every error; a body that isn't `application/json` is
//      415; the operation's `max_body` is 413; a `secured` operation runs behind the
//      service's bearer check (401);
//   3. the document: `GET /openapi.json` serves the OpenAPI 3.1 description of every
//      operation, rendered with packages/json.
//
//     let mut svc = openapi.service("Todo API", "1.0.0")
//     let todo = svc.component("Todo", todo_schema)            // a $ref to components
//     let mut o = openapi.op("GET", "/todos/{id}").operation_id("getTodo")
//     o = o.path_param("id", schema.integer()).returns(200, "The todo", todo).fails(404, "No such todo")
//     svc.add(o, openapi.typed(decode_id, get_todo, encode_todo))
//     let h = svc.handler()                                      // router + /openapi.json
//
// Handlers get an `Input`: the request after validation, with its body parsed. A typed
// handler is three functions (`typed`): decode the Input into a T, a function from T to
// `Result[U, problem.ApiError]`, and encode U as JSON text; it answers with the operation's
// first 2xx status. This is the shape JSON derive (P0.10) or comptime reflection will
// generate from T and U, together with their schemas (docs/openapi.md); until then the
// decoder, the encoder and the schema are written by hand next to each other.

import "core/sys"
import "std/bytes"
import "json"
import "http"
import "http/router"
import "http/problem"
import "http/middleware"
import "schema.ei"

pub type Param = { name: List[u8], loc: List[u8], required: bool, schema: schema.Schema, desc: List[u8] }

/// A response: `media` is the content's media type (empty with no content).
pub type Resp = { status: i32, desc: List[u8], media: List[u8], schema: List[schema.Schema] }

/// An operation. `path` is the OpenAPI template (`/todos/{id}`); `body` holds the request
/// body's schema (none: the operation takes no body); `security` names security schemes
/// (`Service.bearer_auth`); `max_body` is the longest body accepted (0: the server's limit).
pub type Op = {
    method: List[u8],
    path: List[u8],
    operation_id: List[u8],
    summary: List[u8],
    desc: List[u8],
    tags: List[List[u8]],
    params: List[Param],
    body: List[schema.Schema],
    body_required: bool,
    body_desc: List[u8],
    responses: List[Resp],
    security: List[List[u8]],
    max_body: usize,
}

/// An operation on `path` (an OpenAPI path template: `/todos/{id}`).
pub fn op(method: str, path: str) -> Op {
    Op(sys.lit(method), sys.lit(path), List.new(), List.new(), List.new(), List.new(), List.new(), List.new(), false, List.new(), List.new(), List.new(), 0)
}

fn problem_ref() -> schema.Schema { schema.ref_to(sys.lit("Problem"), problem_schema()) }

/// The schema of an RFC 9457 problem as this package writes it.
pub fn problem_schema() -> schema.Schema {
    let mut err = schema.object()
    err = err.field("in", schema.string().allow("body").allow("path").allow("query").allow("header"))
    err = err.prop("pointer", schema.string().describe("A JSON pointer into the body"))
    err = err.prop("name", schema.string().describe("The parameter"))
    err = err.field("detail", schema.string())
    let mut p = schema.object().describe("Problem Details (RFC 9457)")
    p = p.field("type", schema.string()).field("title", schema.string()).field("status", schema.integer())
    p.prop("detail", schema.string()).prop("errors", schema.array(err))
}

impl Op {
    fn operation_id(self, id: str) -> Op {
        let mut o = self.copy()
        o.operation_id = sys.lit(id)
        o
    }

    fn summary(self, s: str) -> Op {
        let mut o = self.copy()
        o.summary = sys.lit(s)
        o
    }

    fn describe(self, s: str) -> Op {
        let mut o = self.copy()
        o.desc = sys.lit(s)
        o
    }

    fn tag(self, t: str) -> Op {
        let mut o = self.copy()
        o.tags.push(sys.lit(t))
        o
    }

    fn param(self, loc: str, name: str, required: bool, s: schema.Schema, desc: str) -> Op {
        let mut o = self.copy()
        o.params.push(Param(sys.lit(name), sys.lit(loc), required, s, sys.lit(desc)))
        o
    }

    /// A path parameter (always required; it must appear in the path as `{name}`).
    fn path_param(self, name: str, s: schema.Schema) -> Op { self.param("path", name, true, s, "") }

    /// An optional query parameter.
    fn query(self, name: str, s: schema.Schema, desc: str) -> Op { self.param("query", name, false, s, desc) }

    /// A required query parameter.
    fn query_required(self, name: str, s: schema.Schema, desc: str) -> Op { self.param("query", name, true, s, desc) }

    /// A header parameter (optional).
    fn header(self, name: str, s: schema.Schema, desc: str) -> Op { self.param("header", name, false, s, desc) }

    /// A required JSON request body.
    fn body(self, s: schema.Schema, desc: str) -> Op {
        let mut o = self.copy()
        o.body = List.new()
        o.body.push(s)
        o.body_required = true
        o.body_desc = sys.lit(desc)
        o
    }

    /// An optional JSON request body.
    fn optional_body(self, s: schema.Schema, desc: str) -> Op {
        let mut o = self.body(s, desc)
        o.body_required = false
        o
    }

    /// The longest body this operation accepts (413 beyond, before validation).
    fn max_body(self, n: usize) -> Op {
        let mut o = self.copy()
        o.max_body = n
        o
    }

    /// A response with a JSON body.
    fn returns(self, status: i32, desc: str, s: schema.Schema) -> Op {
        let mut o = self.copy()
        let mut one: List[schema.Schema] = List.new()
        one.push(s)
        o.responses.push(Resp(status, sys.lit(desc), sys.lit("application/json"), one))
        o
    }

    /// A response without a body (204, ...).
    fn returns_empty(self, status: i32, desc: str) -> Op {
        let mut o = self.copy()
        o.responses.push(Resp(status, sys.lit(desc), List.new(), List.new()))
        o
    }

    /// An error response (a problem+json body).
    fn fails(self, status: i32, desc: str) -> Op {
        let mut o = self.copy()
        let mut one: List[schema.Schema] = List.new()
        one.push(problem_ref())
        o.responses.push(Resp(status, sys.lit(desc), sys.lit(problem.MEDIA), one))
        o
    }

    /// Requires the security scheme `name` (registered with `Service.bearer_auth`).
    fn secured(self, name: str) -> Op {
        let mut o = self.copy()
        o.security.push(sys.lit(name))
        o
    }

    /// The first 2xx status (200 when none is declared).
    fn ok_status(self) -> i32 {
        for r in self.responses {
            if r.status >= 200 && r.status < 300 { return r.status }
        }
        200
    }

    fn has_response(self, status: i32) -> bool {
        for r in self.responses {
            if r.status == status { return true }
        }
        false
    }
}

/// The names in a path template (`/a/{x}/b/{y}` has x and y); panics on a malformed one.
fn template_names(path: List[u8]) -> List[List[u8]] {
    let mut out: List[List[u8]] = List.new()
    for seg in bytes.split(path, 47) {
        if seg.len() > 0 && seg[0] == 123 {
            if seg.len() < 3 || seg[seg.len() - 1] != 125 { panic("openapi: a path parameter is a whole segment {name}") }
            out.push(bytes.slice(seg, 1, seg.len() - 1))
        } else if bytes.find_byte(seg, 123, 0).is_some() || bytes.find_byte(seg, 58, 0).is_some() || bytes.find_byte(seg, 42, 0).is_some() {
            panic("openapi: a path segment is a literal or a whole {name}")
        }
    }
    out
}

/// The router pattern of a path template: `/todos/{id}` is `/todos/:id`.
pub fn pattern(path: List[u8]) -> List[u8] {
    let mut out: List[List[u8]] = List.new()
    for seg in bytes.split(path, 47) {
        if seg.len() > 0 && seg[0] == 123 {
            let mut p = sys.lit(":")
            bytes.append(inout p, bytes.slice(seg, 1, seg.len() - 1))
            out.push(p)
        } else {
            out.push(seg)
        }
    }
    bytes.join(out, sys.lit("/"))
}

/// Panics when the operation's path parameters and its template disagree, or an operation
/// id or a parameter is declared twice (programming errors, found when the service starts).
fn check_op(o: Op) {
    let names = template_names(o.path)
    for n in names {
        let mut found = false
        for p in o.params {
            if bytes.eq(p.loc, sys.lit("path")) && bytes.eq(p.name, n) { found = true }
        }
        if !found { panic("openapi: a {name} in the path has no path_param") }
    }
    for i in 0..o.params.len() {
        let p = o.params[i]
        if bytes.eq(p.loc, sys.lit("path")) {
            let mut found = false
            for n in names {
                if bytes.eq(n, p.name) { found = true }
            }
            if !found { panic("openapi: a path_param is not in the path") }
        }
        for j in 0..i {
            if bytes.eq(o.params[j].name, p.name) && bytes.eq(o.params[j].loc, p.loc) { panic("openapi: a parameter is declared twice") }
        }
        let z = schema.check_text(p.schema, List.new())
    }
}

// ---- the validated input of a handler

/// A request that passed validation: `req` (with path parameters), its body parsed (`doc`,
/// when `has_body`), and `status`, the operation's success status.
pub type Input = { req: http.Request, doc: json.Doc, has_body: bool, status: i32 }

fn missing(what: str, name: str) -> problem.ApiError {
    let mut d = sys.lit(what)
    bytes.append(inout d, sys.lit(" "))
    bytes.append(inout d, sys.lit(name))
    bytes.append(inout d, sys.lit(" is missing or invalid"))
    problem.with_detail(400, d)
}

impl Input {
    /// Path parameter `name` (the router decoded it).
    fn path(self, name: str) -> Result[List[u8], problem.ApiError] { self.req.param(name).ok_or(missing("path parameter", name)) }

    fn path_int(self, name: str) -> Result[i64, problem.ApiError] {
        schema.parse_int(self.path(name)?).ok_or(missing("path parameter", name))
    }

    /// Query parameter `name`, None when absent.
    fn query(self, name: str) -> Option[List[u8]] { self.req.query_param(name) }

    fn query_int(self, name: str) -> Result[Option[i64], problem.ApiError] {
        match self.req.query_param(name) {
            Some(v) => Ok(Some(schema.parse_int(v).ok_or(missing("query parameter", name))?))
            None => Ok(None)
        }
    }

    fn query_bool(self, name: str) -> Result[Option[bool], problem.ApiError] {
        match self.req.query_param(name) {
            Some(v) => {
                if bytes.eq(v, sys.lit("true")) { return Ok(Some(true)) }
                if bytes.eq(v, sys.lit("false")) { return Ok(Some(false)) }
                Err(missing("query parameter", name))
            }
            None => Ok(None)
        }
    }

    /// The body's root node (Err when there is no body).
    fn root(self) -> Result[u32, problem.ApiError] {
        if !self.has_body { return Err(problem.bad_request("a JSON body is required")) }
        Ok(self.doc.root)
    }

    /// Member `name` of the body object, None when absent (null is present).
    fn member(self, name: str) -> Option[u32] {
        if !self.has_body { return None }
        json.field(self.doc, self.doc.root, name)
    }

    /// Whether member `name` is present and null.
    fn is_null(self, name: str) -> bool {
        match self.member(name) {
            Some(n) => json.is_null(self.doc, n)
            None => false
        }
    }

    fn str(self, name: str) -> Result[List[u8], problem.ApiError] {
        let n = self.member(name).ok_or(missing("member", name))?
        json.as_str(self.doc, n).ok_or(missing("member", name))
    }

    fn int(self, name: str) -> Result[i64, problem.ApiError] {
        let n = self.member(name).ok_or(missing("member", name))?
        json.as_int(self.doc, n).ok_or(missing("member", name))
    }

    fn bool(self, name: str) -> Result[bool, problem.ApiError] {
        let n = self.member(name).ok_or(missing("member", name))?
        json.as_bool(self.doc, n).ok_or(missing("member", name))
    }

    /// An optional string member (absent or null: None).
    fn opt_str(self, name: str) -> Option[List[u8]] { json.as_str(self.doc, self.member(name)?) }

    fn opt_int(self, name: str) -> Option[i64] { json.as_int(self.doc, self.member(name)?) }

    fn opt_bool(self, name: str) -> Option[bool] { json.as_bool(self.doc, self.member(name)?) }

    /// The principal a security check found (empty when the operation isn't secured).
    fn principal(self) -> List[u8] { self.req.get_ctx("principal").unwrap_or(List.new()) }
}

// ---- validation

fn param_value(req: http.Request, p: Param) -> Option[List[u8]] {
    if bytes.eq(p.loc, sys.lit("path")) { return http.find(req.params, p.name) }
    if bytes.eq(p.loc, sys.lit("header")) { return http.find(req.headers, p.name) }
    http.query_value(req.query, p.name)
}

/// Checks `req` against `o` (see the module comment): the Input, or the problem to answer.
pub fn validate(o: Op, req: http.Request) -> Result[Input, problem.ApiError] {
    let mut errs: List[problem.FieldError] = List.new()
    for p in o.params {
        match param_value(req, p) {
            Some(v) => {
                match schema.check_text(p.schema, v) {
                    Some(why) => errs.push(problem.FieldError(p.loc, p.name, why))
                    None => {}
                }
            }
            None => {
                if p.required { errs.push(problem.FieldError(p.loc, p.name, sys.lit("is required"))) }
            }
        }
    }
    let mut doc = json.new_doc()
    let mut has_body = false
    if o.body.len() > 0 {
        if req.body.len() == 0 {
            if o.body_required { errs.push(problem.FieldError(sys.lit("body"), sys.lit("#"), sys.lit("a JSON body is required"))) }
        } else if !bytes.eq(req.content_type(), sys.lit("application/json")) {
            return Err(problem.new(415, "the body must be application/json"))
        } else {
            match json.parse(req.body) {
                Ok(d) => {
                    for e in schema.validate(o.body[0], d) { errs.push(e) }
                    doc = d
                    has_body = true
                }
                Err(e) => { errs.push(problem.FieldError(sys.lit("body"), sys.lit("#"), bytes.concat(sys.lit("is not JSON: "), json.error_text(e)))) }
            }
        }
    }
    if errs.len() > 0 {
        let mut p = problem.bad_request("the request does not match the API description")
        p.errors = errs
        return Err(p)
    }
    Ok(Input(req, doc, has_body, o.ok_status()))
}

/// The handler of an operation: `h` behind validation.
pub fn validated(o: Op, h: fn(Input) -> http.Response) -> http.Handler {
    |req: http.Request| -> http.Response {
        match validate(o, req) {
            Ok(i) => h(i)
            Err(e) => e.response()
        }
    }
}

// ---- typed handlers

/// A handler from a decoder, a typed function and an encoder (see the module comment). The
/// answer is the operation's success status with `encode(u)` as an `application/json` body
/// (no body for 204), or the ApiError's problem+json.
pub fn typed[T, U](decode: fn(Input) -> Result[T, problem.ApiError], f: fn(T) -> Result[U, problem.ApiError], encode: fn(U) -> List[u8]) -> fn(Input) -> http.Response {
    |i: Input| -> http.Response {
        let t = match decode(i) {
            Ok(x) => x
            Err(e) => { return e.response() }
        }
        match f(t) {
            Ok(u) => {
                if i.status == 204 { return http.response(204) }
                http.json_response(i.status, encode(u))
            }
            Err(e) => e.response()
        }
    }
}

/// A decoder for operations without input.
pub fn no_input(i: Input) -> Result[bool, problem.ApiError] { Ok(true) }

/// An encoder for operations without output (204).
pub fn no_output(b: bool) -> List[u8] { List.new() }

// ---- writing JSON results

/// A JSON object written member by member: `openapi.obj().int("id", 1).str("title", t).done()`.
pub type Obj = { out: List[u8], n: usize }

pub fn obj() -> Obj { Obj(sys.lit("{"), 0) }

impl Obj {
    fn key(self, k: str) -> Obj {
        let mut o = self.copy()
        if o.n > 0 { o.out.push(44) }
        json.quote_into(inout o.out, sys.lit(k))
        o.out.push(58)
        o.n += 1
        o
    }

    /// A member whose value is JSON text.
    fn raw(self, k: str, v: List[u8]) -> Obj {
        let mut o = self.key(k)
        bytes.append(inout o.out, v)
        o
    }

    fn str(self, k: str, v: List[u8]) -> Obj { self.raw(k, json.quote(v)) }
    fn int(self, k: str, v: i64) -> Obj { self.raw(k, bytes.from_i64(v)) }
    fn bool(self, k: str, v: bool) -> Obj {
        let t = if v { sys.lit("true") } else { sys.lit("false") }
        self.raw(k, t)
    }
    fn nothing(self, k: str) -> Obj { self.raw(k, sys.lit("null")) }

    /// A string member, or null.
    fn opt_str(self, k: str, v: Option[List[u8]]) -> Obj {
        match v {
            Some(s) => self.str(k, s)
            None => self.nothing(k)
        }
    }

    fn done(self) -> List[u8] {
        let mut out = self.out.copy()
        out.push(125)
        out
    }
}

/// A JSON array of JSON texts.
pub fn arr(items: List[List[u8]]) -> List[u8] {
    let mut out = sys.lit("[")
    bytes.append(inout out, bytes.join(items, sys.lit(",")))
    out.push(93)
    out
}

// ---- the document

/// A security scheme: `kind` "bearer" or "basic" (HTTP authentication schemes).
type Scheme = { name: List[u8], kind: List[u8], check: fn(List[u8]) -> Option[List[u8]] }

/// A service: its description and its router (see the module comment).
pub type Service = {
    title: List[u8],
    version: List[u8],
    desc: List[u8],
    ops: List[Op],
    components: List[schema.Prop],
    schemes: List[Scheme],
    r: router.Router,
    doc_path: List[u8],
}

pub fn service(title: str, version: str) -> Service {
    Service(sys.lit(title), sys.lit(version), List.new(), List.new(), List.new(), List.new(), router.new(), sys.lit("/openapi.json"))
}

fn str_node(inout d: json.Doc, s: List[u8]) -> u32 { json.new_string(inout d, s) }

fn content(inout d: json.Doc, media: List[u8], s: schema.Schema) -> u32 {
    let mut sk: List[List[u8]] = List.new()
    sk.push(sys.lit("schema"))
    let mut sv: List[u32] = List.new()
    sv.push(schema.emit(inout d, s))
    let media_obj = json.new_object(inout d, sk, sv)
    let mut ck: List[List[u8]] = List.new()
    ck.push(media)
    let mut cv: List[u32] = List.new()
    cv.push(media_obj)
    json.new_object(inout d, ck, cv)
}

fn lower_method(m: List[u8]) -> List[u8] { http.lower(m) }

impl Service {
    fn describe(inout self, text: str) { self.desc = sys.lit(text) }

    /// Where the document is served (default `/openapi.json`).
    fn serve_doc_at(inout self, path: str) { self.doc_path = sys.lit(path) }

    /// Registers schema `name` under components/schemas; returns a reference to it (use the
    /// reference in operations and other schemas).
    fn component(inout self, name: str, s: schema.Schema) -> schema.Schema {
        let n = sys.lit(name)
        if bytes.eq(n, sys.lit("Problem")) { panic("openapi: the component Problem is the package's own (problem+json)") }
        for c in self.components {
            if bytes.eq(c.name, n) { panic("openapi: a component is registered twice") }
        }
        self.components.push(schema.Prop(n, s))
        schema.ref_to(n, s)
    }

    /// Registers the HTTP bearer scheme `name`: operations that are `secured(name)` run behind
    /// `middleware.bearer(realm, check, ...)` (`check` gives the principal of a valid token).
    fn bearer_auth(inout self, name: str, check: fn(List[u8]) -> Option[List[u8]]) {
        self.schemes.push(Scheme(sys.lit(name), sys.lit("bearer"), check))
    }

    /// Adds operation `o`, answered by `h` after validation (see the module comment).
    fn add(inout self, o: Op, h: fn(Input) -> http.Response) {
        self.add_with(o, |x: http.Handler| -> http.Handler { x }, h)
    }

    /// `add`, with `layer` around the whole route (a timeout, a log for this route, ...).
    fn add_with(inout self, o: Op, layer: http.Middleware, h: fn(Input) -> http.Response) {
        check_op(o)
        for x in self.ops {
            if bytes.eq(x.method, o.method) && bytes.eq(pattern(x.path), pattern(o.path)) { panic("openapi: an operation is added twice") }
            if o.operation_id.len() > 0 && bytes.eq(x.operation_id, o.operation_id) { panic("openapi: an operationId is used twice") }
        }
        let mut full = o.copy()
        // what validation and the security check can answer is documented too
        if (o.params.len() > 0 || o.body.len() > 0) && !o.has_response(400) { full = full.fails(400, "The request does not match this description") }
        if o.security.len() > 0 && !o.has_response(401) { full = full.fails(401, "Missing or invalid credentials") }
        if o.max_body > 0 && !o.has_response(413) { full = full.fails(413, "The body is too large") }
        if o.body.len() > 0 && !o.has_response(415) { full = full.fails(415, "The body is not application/json") }
        let mut handler = validated(full, h)
        for name in o.security {
            let mut found = false
            for s in self.schemes {
                if bytes.eq(s.name, name) {
                    found = true
                    handler = middleware.bearer_in(self.title, s.check, handler)
                }
            }
            if !found { panic("openapi: an operation is secured by an unknown scheme") }
        }
        if o.max_body > 0 { handler = middleware.body_limit(o.max_body, handler) }
        handler = layer(handler)
        self.r.route_bytes(full.method, pattern(full.path), handler)
        self.ops.push(full)
    }

    /// Adds a route that is not part of the description (`/metrics`, `/health`).
    fn raw(inout self, method: str, pat: str, h: http.Handler) { self.r.route(method, pat, h) }

    /// The OpenAPI 3.1 document as a json.Doc.
    fn document(self) -> json.Doc {
        let mut d = json.new_doc()
        let mut ks: List[List[u8]] = List.new()
        let mut vs: List[u32] = List.new()
        ks.push(sys.lit("openapi"))
        vs.push(str_node(inout d, sys.lit("3.1.0")))
        let mut ik: List[List[u8]] = List.new()
        let mut iv: List[u32] = List.new()
        ik.push(sys.lit("title"))
        iv.push(str_node(inout d, self.title))
        ik.push(sys.lit("version"))
        iv.push(str_node(inout d, self.version))
        if self.desc.len() > 0 {
            ik.push(sys.lit("description"))
            iv.push(str_node(inout d, self.desc))
        }
        ks.push(sys.lit("info"))
        vs.push(json.new_object(inout d, ik, iv))
        // paths, in the order they were first used; operations in the order added
        let mut paths: List[List[u8]] = List.new()
        for o in self.ops {
            let mut seen = false
            for p in paths {
                if bytes.eq(p, o.path) { seen = true }
            }
            if !seen { paths.push(o.path) }
        }
        let mut pk: List[List[u8]] = List.new()
        let mut pv: List[u32] = List.new()
        for p in paths {
            let mut mk: List[List[u8]] = List.new()
            let mut mv: List[u32] = List.new()
            for o in self.ops {
                if bytes.eq(o.path, p) {
                    mk.push(lower_method(o.method))
                    mv.push(emit_op(inout d, o))
                }
            }
            pk.push(p)
            pv.push(json.new_object(inout d, mk, mv))
        }
        ks.push(sys.lit("paths"))
        vs.push(json.new_object(inout d, pk, pv))
        // components: the registered schemas, Problem, the security schemes
        let mut ck: List[List[u8]] = List.new()
        let mut cv: List[u32] = List.new()
        let mut sk: List[List[u8]] = List.new()
        let mut sv: List[u32] = List.new()
        for c in self.components {
            sk.push(c.name)
            sv.push(schema.emit(inout d, c.schema))
        }
        sk.push(sys.lit("Problem"))
        sv.push(schema.emit(inout d, problem_schema()))
        ck.push(sys.lit("schemas"))
        cv.push(json.new_object(inout d, sk, sv))
        if self.schemes.len() > 0 {
            let mut xk: List[List[u8]] = List.new()
            let mut xv: List[u32] = List.new()
            for s in self.schemes {
                let mut ak: List[List[u8]] = List.new()
                let mut av: List[u32] = List.new()
                ak.push(sys.lit("type"))
                av.push(str_node(inout d, sys.lit("http")))
                ak.push(sys.lit("scheme"))
                av.push(str_node(inout d, s.kind))
                xk.push(s.name)
                xv.push(json.new_object(inout d, ak, av))
            }
            ck.push(sys.lit("securitySchemes"))
            cv.push(json.new_object(inout d, xk, xv))
        }
        ks.push(sys.lit("components"))
        vs.push(json.new_object(inout d, ck, cv))
        d.root = json.new_object(inout d, ks, vs)
        d
    }

    /// The document as compact JSON text.
    fn document_json(self) -> List[u8] {
        let d = self.document()
        json.write(d, d.root)
    }

    /// The service as a handler: its routes and `GET /openapi.json` (rendered now: add
    /// every operation first).
    fn handler(self) -> http.Handler {
        let doc = self.document_json()
        let mut r = self.r.copy()
        r.route_bytes(sys.lit("GET"), self.doc_path, |q: http.Request| -> http.Response { http.json_response(200, doc) })
        router.handler(r)
    }
}

fn emit_op(inout d: json.Doc, o: Op) -> u32 {
    let mut ks: List[List[u8]] = List.new()
    let mut vs: List[u32] = List.new()
    if o.tags.len() > 0 {
        let mut ts: List[u32] = List.new()
        for t in o.tags { ts.push(str_node(inout d, t)) }
        ks.push(sys.lit("tags"))
        vs.push(json.new_array(inout d, ts))
    }
    if o.summary.len() > 0 {
        ks.push(sys.lit("summary"))
        vs.push(str_node(inout d, o.summary))
    }
    if o.desc.len() > 0 {
        ks.push(sys.lit("description"))
        vs.push(str_node(inout d, o.desc))
    }
    if o.operation_id.len() > 0 {
        ks.push(sys.lit("operationId"))
        vs.push(str_node(inout d, o.operation_id))
    }
    if o.params.len() > 0 {
        let mut ps: List[u32] = List.new()
        for p in o.params {
            let mut pk: List[List[u8]] = List.new()
            let mut pv: List[u32] = List.new()
            pk.push(sys.lit("name"))
            pv.push(str_node(inout d, p.name))
            pk.push(sys.lit("in"))
            pv.push(str_node(inout d, p.loc))
            if p.desc.len() > 0 {
                pk.push(sys.lit("description"))
                pv.push(str_node(inout d, p.desc))
            }
            pk.push(sys.lit("required"))
            pv.push(json.new_bool(inout d, p.required))
            pk.push(sys.lit("schema"))
            pv.push(schema.emit(inout d, p.schema))
            ps.push(json.new_object(inout d, pk, pv))
        }
        ks.push(sys.lit("parameters"))
        vs.push(json.new_array(inout d, ps))
    }
    if o.body.len() > 0 {
        let mut bk: List[List[u8]] = List.new()
        let mut bv: List[u32] = List.new()
        if o.body_desc.len() > 0 {
            bk.push(sys.lit("description"))
            bv.push(str_node(inout d, o.body_desc))
        }
        bk.push(sys.lit("required"))
        bv.push(json.new_bool(inout d, o.body_required))
        bk.push(sys.lit("content"))
        bv.push(content(inout d, sys.lit("application/json"), o.body[0]))
        ks.push(sys.lit("requestBody"))
        vs.push(json.new_object(inout d, bk, bv))
    }
    // responses by status, ascending
    let mut rk: List[List[u8]] = List.new()
    let mut rv: List[u32] = List.new()
    let mut done: List[i32] = List.new()
    while done.len() < o.responses.len() {
        let mut best: Option[usize] = None
        for i in 0..o.responses.len() {
            let st = o.responses[i].status
            if !done.contains(st) {
                let better = match best {
                    Some(b) => st < o.responses[b].status
                    None => true
                }
                if better { best = Some(i) }
            }
        }
        let r = o.responses[best.unwrap()]
        done.push(r.status)
        let mut ek: List[List[u8]] = List.new()
        let mut ev: List[u32] = List.new()
        ek.push(sys.lit("description"))
        ev.push(str_node(inout d, r.desc))
        if r.schema.len() > 0 {
            ek.push(sys.lit("content"))
            ev.push(content(inout d, r.media, r.schema[0]))
        }
        rk.push(bytes.from_i64(r.status as i64))
        rv.push(json.new_object(inout d, ek, ev))
    }
    ks.push(sys.lit("responses"))
    vs.push(json.new_object(inout d, rk, rv))
    if o.security.len() > 0 {
        let mut ss: List[u32] = List.new()
        for s in o.security {
            let mut one: List[List[u8]] = List.new()
            one.push(s)
            let mut none: List[u32] = List.new()
            none.push(json.new_array(inout d, List.new()))
            ss.push(json.new_object(inout d, one, none))
        }
        ks.push(sys.lit("security"))
        vs.push(json.new_array(inout d, ss))
    }
    json.new_object(inout d, ks, vs)
}

// ---- pretty printing

/// Node `id` of `d` as indented JSON text (two spaces; members in their order), ending
/// without a newline: for goldens and for people.
pub fn pretty(d: json.Doc, id: u32) -> List[u8] {
    let mut out: List[u8] = List.new()
    pretty_into(inout out, d, id, 0)
    out
}

fn indent(inout out: List[u8], n: usize) {
    out.push(10)
    for k in 0..n { bytes.append(inout out, sys.lit("  ")) }
}

fn pretty_into(inout out: List[u8], d: json.Doc, id: u32, depth: usize) {
    let k = json.kind(d, id)
    let n = json.len(d, id)
    if k == json.ARRAY && n > 0 {
        out.push(91)
        for i in 0..n {
            if i > 0 { out.push(44) }
            indent(inout out, depth + 1)
            pretty_into(inout out, d, json.at(d, id, i).unwrap(), depth + 1)
        }
        indent(inout out, depth)
        out.push(93)
        return
    }
    if k == json.OBJECT && n > 0 {
        out.push(123)
        for i in 0..n {
            if i > 0 { out.push(44) }
            indent(inout out, depth + 1)
            bytes.append(inout out, json.write(d, json.key_at(d, id, i).unwrap()))
            bytes.append(inout out, sys.lit(": "))
            pretty_into(inout out, d, json.val_at(d, id, i).unwrap(), depth + 1)
        }
        indent(inout out, depth)
        out.push(125)
        return
    }
    bytes.append(inout out, json.write(d, id))
}
